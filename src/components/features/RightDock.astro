---
import { Icon } from "astro-icon/components";
---

<div class="right-dock" data-dock data-collapsed="true" aria-label="右侧工具台">
	<button type="button" data-dock-toggle class="dock-toggle" title="展开工具台">
		<Icon is:inline name="material-symbols:keyboard-double-arrow-left-rounded" class="dock-expand-icon" />
		<Icon is:inline name="material-symbols:keyboard-double-arrow-right-rounded" class="dock-collapse-icon" />
	</button>

	<div class="dock-items">
		<button type="button" data-dock-action="dark" title="暗色模式" class="dock-item">
			<Icon is:inline name="material-symbols:dark-mode-outline-rounded" />
		</button>
		<a href="/guestbook/" title="留言" class="dock-item">
			<Icon is:inline name="material-symbols:chat-rounded" />
		</a>
		<button type="button" data-dock-action="theme" title="主题色" class="dock-item">
			<Icon is:inline name="material-symbols:palette-rounded" />
		</button>
		<button type="button" data-dock-action="ai" title="AI 助手" class="dock-item">
			<Icon is:inline name="material-symbols:auto-awesome-rounded" />
		</button>
		<button type="button" data-dock-action="music" title="音乐" class="dock-item">
			<Icon is:inline name="material-symbols:music-note-rounded" />
		</button>
		<button type="button" data-dock-action="sound" title="音效" class="dock-item">
			<Icon is:inline name="material-symbols:graphic-eq-rounded" />
		</button>
		<a href="/search/" title="搜索" class="dock-item">
			<Icon is:inline name="material-symbols:search-rounded" />
		</a>
		<a href="/categories/" title="分类" class="dock-item">
			<Icon is:inline name="material-symbols:folder-open-rounded" />
		</a>
		<a href="/#announcements" title="公告" class="dock-item">
			<Icon is:inline name="material-symbols:campaign-rounded" />
		</a>
	</div>

	<div class="dock-ai-panel hidden" data-dock-ai-panel>
		<div class="dock-ai-title">AI 助手</div>
		<input type="text" data-ai-query placeholder="输入问题，选择入口打开" class="dock-ai-input" />
		<div class="dock-ai-actions">
			<button type="button" data-ai-target="chatgpt">ChatGPT</button>
			<button type="button" data-ai-target="deepseek">DeepSeek</button>
			<button type="button" data-ai-target="bing">Bing</button>
			<button type="button" data-ai-target="site">站内搜索</button>
		</div>
	</div>
</div>

<script is:inline>
	(function () {
		var dock = document.querySelector("[data-dock]");
		if (!dock) return;

		var toggle = dock.querySelector("[data-dock-toggle]");
		var aiPanel = dock.querySelector("[data-dock-ai-panel]");
		var aiInput = dock.querySelector("[data-ai-query]");

		function setCollapsed(collapsed) {
			dock.dataset.collapsed = collapsed ? "true" : "false";
			if (aiPanel) aiPanel.classList.add("hidden");
			toggle.title = collapsed ? "展开工具台" : "收起工具台";
		}

		function openAiTarget(target) {
			var query = (aiInput && aiInput.value || "").trim();
			var urls = {
				chatgpt: "https://chatgpt.com/?q=",
				deepseek: "https://chat.deepseek.com/?q=",
				bing: "https://www.bing.com/search?q=",
				site: "/search/?q=",
			};
			var base = urls[target];
			if (!base) return;
			window.open(base + encodeURIComponent(query || ""), "_blank", "noopener,noreferrer");
		}

		toggle.addEventListener("click", function () {
			setCollapsed(dock.dataset.collapsed !== "true");
		});

		dock.addEventListener("click", function (e) {
			if (e.target.closest("[data-dock-ai-panel]")) {
				var targetBtn = e.target.closest("[data-ai-target]");
				if (targetBtn) openAiTarget(targetBtn.dataset.aiTarget);
				return;
			}

			var actionBtn = e.target.closest("[data-dock-action]");
			if (!actionBtn) return;
			var action = actionBtn.dataset.dockAction;

			if (action === "dark") {
				var isDark = document.documentElement.classList.contains("dark");
				if (isDark) {
					document.documentElement.classList.remove("dark");
					localStorage.setItem("theme", "light");
				} else {
					document.documentElement.classList.add("dark");
					localStorage.setItem("theme", "dark");
				}
				window.dispatchEvent(new CustomEvent("theme-change"));
				return;
			}

			if (action === "theme") {
				var displaySwitch = document.getElementById("display-settings-switch");
				if (displaySwitch) displaySwitch.click();
				return;
			}

			if (action === "music") {
				var musicSwitch = document.getElementById("music-player-switch");
				if (musicSwitch) musicSwitch.click();
				return;
			}

			if (action === "sound") {
				var sfx = window.fireflySound;
				if (sfx && typeof sfx.toggle === "function") sfx.toggle();
				return;
			}

			if (action === "ai") {
				if (aiPanel) aiPanel.classList.toggle("hidden");
			}
		});
	})();
</script>

<style>
	.right-dock {
		position: fixed;
		top: 50%;
		right: 1rem;
		transform: translateY(-50%);
		z-index: 1000;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		width: 3.25rem;
		padding: 0.5rem;
		border-radius: 1rem;
		border: 1px solid var(--line-divider);
		background: color-mix(in srgb, var(--card-bg) 86%, transparent);
		backdrop-filter: blur(12px);
		box-shadow: 0 8px 24px -12px rgb(0 0 0 / 0.25);
	}

	.dock-toggle {
		width: 2.5rem;
		height: 2.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 0.75rem;
		color: var(--btn-content);
		background: var(--btn-regular-bg);
		transition: all 0.2s ease;
	}

	.dock-toggle:hover {
		background: var(--btn-regular-bg-hover);
	}

	.dock-items {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		overflow: hidden;
		transition: max-height 0.3s ease, opacity 0.2s ease;
		max-height: 30rem;
		opacity: 1;
	}

	.dock-item {
		width: 2.5rem;
		height: 2.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 0.75rem;
		color: var(--btn-content);
		background: var(--btn-regular-bg);
		font-size: 1.25rem;
		transition: all 0.2s ease;
	}

	.dock-item:hover {
		background: var(--primary);
		color: #fff;
		transform: scale(1.08);
	}

	.right-dock[data-collapsed="true"] .dock-items {
		max-height: 0;
		opacity: 0;
		pointer-events: none;
	}

	.right-dock[data-collapsed="true"] .dock-expand-icon {
		display: block;
	}

	.right-dock[data-collapsed="true"] .dock-collapse-icon {
		display: none;
	}

	.right-dock[data-collapsed="false"] .dock-expand-icon {
		display: none;
	}

	.right-dock[data-collapsed="false"] .dock-collapse-icon {
		display: block;
	}

	.dock-ai-panel {
		position: absolute;
		right: calc(100% + 0.75rem);
		top: 6rem;
		width: 14rem;
		padding: 0.75rem;
		border-radius: 0.75rem;
		border: 1px solid var(--line-divider);
		background: var(--card-bg);
		box-shadow: 0 8px 24px -12px rgb(0 0 0 / 0.3);
	}

	.dock-ai-title {
		font-weight: 700;
		font-size: 0.85rem;
		margin-bottom: 0.5rem;
	}

	.dock-ai-input {
		width: 100%;
		padding: 0.5rem 0.625rem;
		margin-bottom: 0.5rem;
		font-size: 0.75rem;
		border-radius: 0.5rem;
		border: 1px solid var(--line-divider);
		background: transparent;
		color: var(--btn-content);
		outline: none;
	}

	.dock-ai-input:focus {
		border-color: var(--primary);
	}

	.dock-ai-actions {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.35rem;
	}

	.dock-ai-actions button {
		padding: 0.4rem 0.5rem;
		font-size: 0.7rem;
		border-radius: 0.5rem;
		border: 1px solid var(--line-divider);
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.dock-ai-actions button:hover {
		background: var(--primary);
		color: #fff;
	}

	@media (max-width: 768px) {
		.right-dock {
			right: 0.5rem;
		}
	}
</style>
