---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;

const skills = [
	"Astro",
	"Svelte",
	"TypeScript",
	"Tailwind CSS",
	"Cloudflare",
	"AI 工具",
	"自动化",
	"静态博客",
];
---

<WidgetLayout
	name="技能与工具"
	showTitle={showTitle}
	id="skill-tools"
	class={className}
	style={style}
>
	<div class="flex flex-wrap gap-2">
		{skills.map((skill) => (
			<span class="px-3 py-1.5 rounded-full bg-(--primary)/10 text-(--primary) text-sm font-medium">
				{skill}
			</span>
		))}
	</div>
</WidgetLayout>
