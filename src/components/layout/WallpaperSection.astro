---
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import ScrollDownIndicator from "@/components/controls/ScrollDownIndicator.astro";
import BackgroundPlayer from "@/components/features/BackgroundPlayer.astro";
import BannerHomeTextOverlay from "@/components/layout/BannerHomeTextOverlay.astro";
import BannerPostMetaOverlay from "@/components/layout/BannerPostMetaOverlay.astro";
import { backgroundWallpaper } from "@/config";
import { CHARACTERS, SKILLS } from "@/utils/hero-content";
import heroFallback from "@/assets/images/DesktopWallpaper/mufeng-gojo.png";
import { BANNER_HEIGHT_EXTEND } from "@/constants/constants";
import type {
	BannerPostMeta,
	BannerVisibilityState,
} from "@/utils/banner-visibility-utils";
import type { BackgroundImages } from "@/utils/layout-utils";

interface Props {
	state: BannerVisibilityState;
	backgroundImages: BackgroundImages;
	isHomePage: boolean;
	title?: string;
	bannerPostMeta?: BannerPostMeta;
}

const { state, backgroundImages, isHomePage, title, bannerPostMeta } =
	Astro.props;

const hero3D = backgroundWallpaper.hero3D;
const hero3DEnabled = !!(hero3D && hero3D.enabled);
---

<!-- Wallpaper - 如果允许切换则始终渲染，否则只渲染当前模式 -->
{(state.isWallpaperSwitchable || state.isBannerMode || state.isFullscreenMode || state.isOverlayMode) && (
<div id="wallpaper-wrapper" class:list={[
	`absolute z-10 w-full transition duration-700 overflow-hidden ${state.mobileNonHomeBannerClass}`,
	(state.isOverlayMode && !state.isWallpaperSwitchable) ? 'wallpaper-overlay' : '',
	(state.isFullscreenMode && !state.isWallpaperSwitchable) ? 'wallpaper-fullscreen' : '',
]} style={
	state.isWallpaperSwitchable
		? (state.isBannerMode
			? `top: -${BANNER_HEIGHT_EXTEND}vh; --overlay-opacity: ${backgroundWallpaper.overlay?.opacity ?? 0.8}; --overlay-z-index: ${backgroundWallpaper.overlay?.zIndex ?? -1}; --overlay-blur: ${backgroundWallpaper.overlay?.blur ?? 0}px;`
			: `display: none; --overlay-opacity: ${backgroundWallpaper.overlay?.opacity ?? 0.8}; --overlay-z-index: ${backgroundWallpaper.overlay?.zIndex ?? -1}; --overlay-blur: ${backgroundWallpaper.overlay?.blur ?? 0}px;`)
		: state.isOverlayMode
			? `--overlay-opacity: ${backgroundWallpaper.overlay?.opacity ?? 0.8}; --overlay-z-index: ${backgroundWallpaper.overlay?.zIndex ?? -1}; --overlay-blur: ${backgroundWallpaper.overlay?.blur ?? 0}px;`
			: state.isFullscreenMode
				? `--overlay-opacity: ${backgroundWallpaper.overlay?.opacity ?? 0.8}; --overlay-z-index: ${backgroundWallpaper.overlay?.zIndex ?? -1}; --overlay-blur: ${backgroundWallpaper.overlay?.blur ?? 0}px;`
				: `top: -${BANNER_HEIGHT_EXTEND}vh`
}>
    <!-- 背景图片显示 -->
    {state.hasMultipleImages ? (
    /* 轮播模式：渲染所有图片为 slide-item */
    <div class:list={["relative h-full w-full bg-(--page-bg)", `effect-${state.bannerCarouselEffect}`]} id="banner-images-container"
         style={`z-index: 5; --carousel-interval: ${state.bannerCarouselInterval}ms`}
         data-carousel-enabled={state.bannerCarouselEnabledDefault}
         data-carousel-switchable={state.bannerCarouselSwitchable}
         data-carousel-interval={state.bannerCarouselInterval}
         data-carousel-effect={state.bannerCarouselEffect}>
        {/* 图片放在 <template> 里，浏览器不会发起请求；由轮播脚本挑中随机那张后克隆进 DOM */}
        {backgroundImages.mobile.map((src, index) => (
            <div class:list={["slide-item block lg:hidden", index === 0 && "active"]} data-index={index}>
                <template>
                    <ImageWrapper
                        alt="Mobile background image of the blog"
                        class="object-cover h-full w-full"
                        src={src}
                        position={backgroundWallpaper.banner?.position}
                        width={828}
                        widths={[640, 828]}
                        sizes="100vw"
                        loading="eager"
                        quality={state.mobileQuality}
                    />
                </template>
            </div>
        ))}
        {backgroundImages.desktop.map((src, index) => (
            <div class:list={["slide-item hidden lg:block", index === 0 && "active"]} data-index={index}>
                <template>
                    <ImageWrapper
                        id="banner"
                        alt="Desktop background image of the blog"
                        class="object-cover h-full"
                        src={src}
                        position={backgroundWallpaper.banner?.position}
                        width={1920}
                        widths={[1280, 1920]}
                        sizes="100vw"
                        loading="eager"
                        quality={state.configQuality}
                    />
                </template>
            </div>
        ))}
        <noscript>
            {backgroundImages.mobile.length > 0 && (
                <div class="slide-item active block lg:hidden">
                    <ImageWrapper
                        alt="Mobile background image of the blog"
                        class="object-cover h-full w-full"
                        src={backgroundImages.mobile[0]}
                        position={backgroundWallpaper.banner?.position}
                        width={828}
                        widths={[640, 828]}
                        sizes="100vw"
                        loading="eager"
                        fetchpriority="high"
                        fadeIn={false}
                        quality={state.mobileQuality}
                    />
                </div>
            )}
            {backgroundImages.desktop.length > 0 && (
                <div class="slide-item active hidden lg:block">
                    <ImageWrapper
                        alt="Desktop background image of the blog"
                        class="object-cover h-full"
                        src={backgroundImages.desktop[0]}
                        position={backgroundWallpaper.banner?.position}
                        width={1920}
                        widths={[1280, 1920]}
                        sizes="100vw"
                        loading="eager"
                        fetchpriority="high"
                        fadeIn={false}
                        quality={state.configQuality}
                    />
                </div>
            )}
        </noscript>
    </div>
    ) : (
    /* 单图模式 */
    <div class="relative h-full w-full" id="banner-images-container">
        {/* 两侧都放在 <template> 里，由下面的脚本按 matchMedia 只实例化匹配的那一侧，
            避免桌面端白下一张手机图（display:none 挡不住 loading="eager"） */}
        {backgroundImages.mobile.length > 0 && (
            <div class="banner-image-slot absolute inset-0 block lg:hidden">
                <template>
                    <ImageWrapper
                        alt="Mobile background image of the blog"
                        class="object-cover h-full w-full"
                        src={backgroundImages.mobile[0]}
                        position={backgroundWallpaper.banner?.position}
                        width={828}
                        widths={[640, 828]}
                        sizes="100vw"
                        loading="eager"
                        quality={state.mobileQuality}
                    />
                </template>
            </div>
        )}
        {backgroundImages.desktop.length > 0 && (
            <div class="banner-image-slot absolute inset-0 hidden lg:block">
                <template>
                    <ImageWrapper
                        id="banner"
                        alt="Desktop background image of the blog"
                        class="object-cover h-full"
                        src={backgroundImages.desktop[0]}
                        position={backgroundWallpaper.banner?.position}
                        width={1920}
                        widths={[1280, 1920]}
                        sizes="100vw"
                        loading="eager"
                        quality={state.configQuality}
                    />
                </template>
            </div>
        )}
        <noscript>
            {backgroundImages.mobile.length > 0 && (
                <div class="absolute inset-0 block lg:hidden">
                    <ImageWrapper
                        alt="Mobile background image of the blog"
                        class="object-cover h-full w-full"
                        src={backgroundImages.mobile[0]}
                        position={backgroundWallpaper.banner?.position}
                        width={828}
                        widths={[640, 828]}
                        sizes="100vw"
                        loading="eager"
                        fetchpriority="high"
                        fadeIn={false}
                        quality={state.mobileQuality}
                    />
                </div>
            )}
            {backgroundImages.desktop.length > 0 && (
                <div class="absolute inset-0 hidden lg:block">
                    <ImageWrapper
                        alt="Desktop background image of the blog"
                        class="object-cover h-full"
                        src={backgroundImages.desktop[0]}
                        position={backgroundWallpaper.banner?.position}
                        width={1920}
                        widths={[1280, 1920]}
                        sizes="100vw"
                        loading="eager"
                        fetchpriority="high"
                        fadeIn={false}
                        quality={state.configQuality}
                    />
                </div>
            )}
        </noscript>
    </div>
    )}

    <!-- 首页实时 3D 角色场景（仅全屏/首页生效；非首页隐藏并回退图片壁纸） -->
    {hero3DEnabled && (
    <div id="hero-3d-layer" class="hero-3d-layer" style={isHomePage ? "display:block" : "display:none"}>
        <canvas id="hero-3d-canvas" class="hero-3d-canvas"></canvas>
        <img id="hero-3d-fallback" class="hero-3d-fallback" src={heroFallback.src} alt="五条悟 3D 壁纸" />

        <!-- 顶部角色信息 -->
        <div class="hero-char-info">
            <span id="hero-char-name" class="hero-char-name"></span>
            <span id="hero-char-title" class="hero-char-title"></span>
        </div>

        <!-- 技能栏：苍 / 赫 / 茈 -->
        <div class="hero-skill-bar">
            {SKILLS.map((s) => (
                <button type="button" class="hero-skill-btn" data-skill={s.key} title={s.desc}
                    style={`--skill-color:#${s.color.toString(16).padStart(6, "0")}`}>
                    <span class="hero-skill-label">{s.label}</span>
                </button>
            ))}
        </div>

        <!-- 角色切换 -->
        <div class="hero-char-switch">
            {CHARACTERS.map((c, i) => (
                <button type="button" class="hero-char-btn" data-char={i} title={c.title}
                    style={`--c:#${c.auraColor.toString(16).padStart(6, "0")}`}>
                    <span class="hero-char-btn-dot"></span>
                    <span class="hero-char-btn-name">{c.name}</span>
                </button>
            ))}
        </div>

        <!-- 数据卡片：音乐 / 3D 实验室（导航中枢） -->
        <div class="hero-cards">
            <button type="button" class="hero-card" data-action="music" title="播放 / 暂停音乐">
                <span class="hero-card-icon hero-card-icon-music"><span class="hero-vinyl"></span></span>
                <span class="hero-card-text"><b>音乐</b><i>此刻单曲循环</i></span>
            </button>
            <a class="hero-card" href="/lab/" title="进入 3D 实验室">
                <span class="hero-card-icon hero-card-icon-lab"><span class="hero-cube"><i></i><i></i><i></i><i></i><i></i><i></i></span></span>
                <span class="hero-card-text"><b>3D 实验室</b><i>造物 · 查看模型</i></span>
            </a>
        </div>

        <!-- 台词气泡 -->
        <div id="hero-3d-toast" class="hero-toast"></div>
    </div>
    )}

    <!-- 壁纸轮播脚本（基于 CSS transition） -->
    {state.hasMultipleImages && (
    <script is:inline data-swup-ignore-script>
        (function initBannerCarousel() {
            var container = document.getElementById('banner-images-container');
            if (!container) return;

            var WALLPAPER_BANNER = 'banner';
            var interval = parseInt(container.dataset.carouselInterval || '5000', 10);
            var switchable = container.dataset.carouselSwitchable === 'true';
            var defaultEnabled = container.dataset.carouselEnabled === 'true';
            var effect = container.dataset.carouselEffect || 'fade';
            var transitioning = false;

            function isCarouselEnabled() {
                if (!switchable) return defaultEnabled;
                var stored = localStorage.getItem('bannerCarouselEnabled');
                if (stored === null) return defaultEnabled;
                return stored === 'true';
            }

            function isBannerWallpaperMode() {
                var mode = document.documentElement.getAttribute('data-wallpaper-mode');
                return mode === WALLPAPER_BANNER || mode === 'fullscreen';
            }

            // 图片淡入：Layout 里的全局 initImageLoadFadeIn 只在解析期扫一次，
            // 之后克隆进来的图片得自己接管，否则会一直停在 opacity-0
            function fadeInWhenLoaded(root) {
                var ph = root.querySelector('.lqip-placeholder');
                var img = root.querySelector('img');
                if (!img) return;
                function done() {
                    img.style.opacity = '1';
                    if (ph) ph.classList.add('loaded');
                }
                if (img.complete && img.naturalWidth > 0) {
                    done();
                } else {
                    img.addEventListener('load', done, { once: true });
                    img.addEventListener('error', function () {
                        if (ph) ph.classList.add('loaded');
                    }, { once: true });
                }
            }

            // 把 <template> 里的图片实例化进 DOM —— 插入的那一刻才开始下载
            function materialize(slideEl, high) {
                if (!slideEl) return false;
                var tpl = slideEl.querySelector('template');
                if (!tpl) return false;
                var frag = tpl.content.cloneNode(true);
                if (high) {
                    var img = frag.querySelector('img');
                    // 必须在插入前写，插入即发起请求
                    if (img) {
                        img.setAttribute('fetchpriority', 'high');
                        // 这张是 LCP 元素，不做淡入：图片没下完时 <img> 本来就不画东西，
                        // 那 500ms 过渡只是把已经能看的画面又藏半秒，Chrome 会把 LCP 往后记。
                        img.classList.remove('opacity-0', 'transition-opacity', 'duration-500', 'ease-out');
                        img.style.opacity = '1';
                    }
                    // LQIP 占位层是 absolute + z-index:0，盖在 img 上面，
                    // 它那 0.5s 淡出同样会挡住 LCP
                    var ph = frag.querySelector('.lqip-placeholder');
                    if (ph) ph.style.transition = 'none';
                }
                slideEl.appendChild(frag);
                tpl.remove();
                fadeInWhenLoaded(slideEl);
                return true;
            }

            // 预取下一张，避免切换时闪一帧黑
            function materializeAhead(slides, index) {
                if (slides.length < 2) return;
                materialize(slides[(index + 1) % slides.length], false);
            }

            // 获取当前设备可见的 slide-item
            function getVisibleSlides() {
                var all = container.querySelectorAll('.slide-item');
                var isLg = window.innerWidth >= 1024;
                var visible = [];
                for (var i = 0; i < all.length; i++) {
                    var el = all[i];
                    if (isLg && el.classList.contains('lg:hidden')) continue;
                    if (!isLg && el.classList.contains('hidden') && !el.classList.contains('lg:hidden')) continue;
                    visible.push(el);
                }
                if (visible.length === 0) {
                    for (var j = 0; j < all.length; j++) visible.push(all[j]);
                }
                return visible;
            }

            function getCurrentIndex(slides) {
                for (var i = 0; i < slides.length; i++) {
                    if (slides[i].classList.contains('active')) return i;
                }
                return 0;
            }

            function applySlideChange(slides, nextIndex) {
                // Slide 效果需要 prev-waiting 辅助类
                if (effect === 'slide') {
                    for (var i = 0; i < slides.length; i++) {
                        slides[i].classList.remove('prev-waiting');
                        if (i < nextIndex) slides[i].classList.add('prev-waiting');
                    }
                }
                if (effect === 'kenburns') {
                    // Ken Burns: 交叉淡入淡出，先激活新图再隐藏旧图
                    slides[nextIndex].classList.add('active');
                    requestAnimationFrame(function() {
                        for (var j = 0; j < slides.length; j++) {
                            if (j !== nextIndex) slides[j].classList.remove('active');
                        }
                    });
                } else {
                    for (var j = 0; j < slides.length; j++) {
                        if (j === nextIndex) slides[j].classList.add('active');
                        else slides[j].classList.remove('active');
                    }
                }
            }

            function changeToSlide(targetIndex, resetProgress) {
                var slides = getVisibleSlides();
                if (slides.length <= 1) return;
                if (transitioning) return;

                var nextIndex = targetIndex;
                if (nextIndex >= slides.length) nextIndex = 0;
                else if (nextIndex < 0) nextIndex = slides.length - 1;

                var currentIndex = getCurrentIndex(slides);
                if (nextIndex === currentIndex) return;

                // 目标图可能还躺在 <template> 里，先实例化再切
                materialize(slides[nextIndex], false);
                materializeAhead(slides, nextIndex);

                // 直接切换（CSS 处理过渡动画）
                applySlideChange(slides, nextIndex);

                if (resetProgress !== false && appState.isPlaying) {
                    startAutoPlay();
                }
            }

            var appState = {
                isPlaying: false,
                autoPlayTimer: null,
                touchStartX: 0,
                touchEndX: 0
            };

            function startAutoPlay() {
                stopAutoPlay();
                if (!isCarouselEnabled()) return;
                if (!isBannerWallpaperMode()) return;

                appState.isPlaying = true;
                appState.autoPlayTimer = setTimeout(function advance() {
                    if (!appState.isPlaying) return;
                    var slides = getVisibleSlides();
                    var currentIdx = getCurrentIndex(slides);
                    changeToSlide(currentIdx + 1, false);
                    appState.autoPlayTimer = setTimeout(advance, interval);
                }, interval);
            }

            function stopAutoPlay() {
                appState.isPlaying = false;
                if (appState.autoPlayTimer) {
                    clearTimeout(appState.autoPlayTimer);
                    appState.autoPlayTimer = null;
                }
            }

            // 键盘控制
            document.addEventListener('keydown', function(e) {
                if (!isBannerWallpaperMode() || !isCarouselEnabled()) return;
                if (e.key === 'ArrowRight') {
                    var slides = getVisibleSlides();
                    changeToSlide(getCurrentIndex(slides) + 1);
                } else if (e.key === 'ArrowLeft') {
                    var slides2 = getVisibleSlides();
                    changeToSlide(getCurrentIndex(slides2) - 1);
                } else if (e.key === ' ') {
                    e.preventDefault();
                    appState.isPlaying ? stopAutoPlay() : startAutoPlay();
                }
            });

            // 触屏滑动
            document.addEventListener('touchstart', function(e) {
                appState.touchStartX = e.changedTouches[0].screenX;
            }, { passive: true });
            document.addEventListener('touchend', function(e) {
                appState.touchEndX = e.changedTouches[0].screenX;
                var diff = appState.touchEndX - appState.touchStartX;
                if (Math.abs(diff) > 50) {
                    var slides = getVisibleSlides();
                    if (diff > 0) changeToSlide(getCurrentIndex(slides) - 1);
                    else changeToSlide(getCurrentIndex(slides) + 1);
                }
            }, { passive: true });

            // 事件监听
            window.addEventListener('bannerCarouselChange', function(e) {
                e.detail && e.detail.enabled ? startAutoPlay() : stopAutoPlay();
            });
            window.addEventListener('wallpaperModeChange', function(e) {
                if (e.detail && (e.detail.mode === 'banner' || e.detail.mode === 'fullscreen')) {
                    if (isCarouselEnabled()) startAutoPlay();
                } else {
                    stopAutoPlay();
                }
            });

            // 随机首张：只有被抽中的这一张会真的下载，其余仍留在 <template> 里
            var slides = getVisibleSlides();
            var startIdx = slides.length > 1 ? Math.floor(Math.random() * slides.length) : 0;
            var firstSlide = slides[startIdx];
            // .slide-item 自带 1000ms 的 opacity 过渡，首张不该吃它（它是 LCP 元素）。
            // 必须在下面加 active 之前就关掉，否则过渡已经启动了。
            if (firstSlide) firstSlide.style.transition = 'none';
            for (var k = 0; k < slides.length; k++) {
                if (k === startIdx) slides[k].classList.add('active');
                else slides[k].classList.remove('active');
            }
            materialize(firstSlide, true);
            if (firstSlide) {
                // 下一帧再放开，后续轮播切换的交叉淡入照旧。双 rAF 是为了确保
                // opacity:1 已经 flush 成新的 before-change style，恢复时不会倒着跑一遍
                requestAnimationFrame(function () {
                    requestAnimationFrame(function () { firstSlide.style.transition = ''; });
                });
            }

            // 断点跨过 1024px 时，另一侧那组还没有实例化过的 active，需要补上
            if (window.matchMedia) {
                var lgQuery = window.matchMedia('(min-width: 1024px)');
                var onBreakpointChange = function () {
                    var s = getVisibleSlides();
                    if (!s.length) return;
                    var hasActive = false;
                    for (var i = 0; i < s.length; i++) {
                        if (s[i].classList.contains('active')) { hasActive = true; break; }
                    }
                    if (!hasActive) s[0].classList.add('active');
                    var idx = getCurrentIndex(s);
                    materialize(s[idx], false);
                    if (isCarouselEnabled()) materializeAhead(s, idx);
                };
                if (lgQuery.addEventListener) lgQuery.addEventListener('change', onBreakpointChange);
                else if (lgQuery.addListener) lgQuery.addListener(onBreakpointChange);
            }

            // 空闲时预取下一张（轮播关掉时其余图片永远不会显示，一张都不下）
            if (isCarouselEnabled()) {
                var schedulePrefetch = function () {
                    var idle = window.requestIdleCallback || function (cb) { return setTimeout(cb, 1500); };
                    idle(function () { materializeAhead(getVisibleSlides(), startIdx); });
                };
                if (document.readyState === 'complete') schedulePrefetch();
                else window.addEventListener('load', schedulePrefetch, { once: true });
            }

            // 启动
            if (isCarouselEnabled() && isBannerWallpaperMode()) {
                startAutoPlay();
            }
        })();
    </script>
    )}

    <!-- 单图模式：只实例化当前断点匹配的那一侧 -->
    {!state.hasMultipleImages && (
    <script is:inline data-swup-ignore-script>
        (function initBannerSingle() {
            var container = document.getElementById('banner-images-container');
            if (!container) return;

            function materialize(slot, high) {
                var tpl = slot.querySelector('template');
                if (!tpl) return;
                var frag = tpl.content.cloneNode(true);
                var img = frag.querySelector('img');
                var phFrag = frag.querySelector('.lqip-placeholder');
                if (img && high) {
                    img.setAttribute('fetchpriority', 'high');
                    // 这张是 LCP 元素，不做淡入：图片没下完时 <img> 本来就不画东西，
                    // 那 500ms 过渡只是把已经能看的画面又藏半秒，Chrome 会把 LCP 往后记。
                    img.classList.remove('opacity-0', 'transition-opacity', 'duration-500', 'ease-out');
                    img.style.opacity = '1';
                    // LQIP 占位层盖在 img 上面（z-index:0），它那 0.5s 淡出同样会挡住 LCP
                    if (phFrag) phFrag.style.transition = 'none';
                }
                slot.appendChild(frag);
                tpl.remove();
                // Layout 的全局淡入只扫解析期的图片，克隆进来的要自己接管
                var ph = slot.querySelector('.lqip-placeholder');
                if (!img) return;
                function done() {
                    img.style.opacity = '1';
                    if (ph) ph.classList.add('loaded');
                }
                if (img.complete && img.naturalWidth > 0) done();
                else {
                    img.addEventListener('load', done, { once: true });
                    img.addEventListener('error', function () {
                        if (ph) ph.classList.add('loaded');
                    }, { once: true });
                }
            }

            function sync() {
                var all = container.querySelectorAll('.banner-image-slot');
                var isLg = window.innerWidth >= 1024;
                for (var i = 0; i < all.length; i++) {
                    var el = all[i];
                    if (isLg && el.classList.contains('lg:hidden')) continue;
                    if (!isLg && el.classList.contains('hidden') && !el.classList.contains('lg:hidden')) continue;
                    materialize(el, true);
                }
            }

            sync();

            if (window.matchMedia) {
                var lgQuery = window.matchMedia('(min-width: 1024px)');
                if (lgQuery.addEventListener) lgQuery.addEventListener('change', sync);
                else if (lgQuery.addListener) lgQuery.addListener(sync);
            }
        })();
    </script>
    )}
    
    {backgroundWallpaper.playerEnable && typeof backgroundWallpaper.src === "object" && !Array.isArray(backgroundWallpaper.src) && backgroundWallpaper.src.playerUrl && !(hero3DEnabled && isHomePage) && (
        <BackgroundPlayer playerUrl={backgroundWallpaper.src.playerUrl} playerMode={backgroundWallpaper.common?.playerMode ?? "order"} />
    )}

    <div id="banner-dim-container" class="absolute inset-0 z-10 pointer-events-none">
        {state.showBannerDim && <div class="banner-dim-overlay absolute inset-0" style={`background: rgba(0, 0, 0, ${state.dimOpacity})`}></div>}
    </div>

    <div id="banner-overlay-container" class="absolute inset-0 z-20 pointer-events-none transition-swup-fade">    <!-- Home page text overlay - 始终渲染以便切换模式时控制显示 -->
    <BannerHomeTextOverlay showHomeText={state.showHomeText} initialRandomSubtitle={state.initialRandomSubtitle} />

    <!-- Non-home non-post page title overlay (desktop only) -->
    {state.showBannerPageTitle && (
        <div class="banner-page-title-overlay absolute inset-0 z-20 hidden lg:flex items-center justify-center pointer-events-none">
            <div class="w-4/5 lg:w-3/4 text-center mb-0">
                <div class="banner-page-title font-bold text-white leading-tight inline-flex items-center justify-center gap-3">
                    {/* <Icon is:inline name="material-symbols:bookmark-rounded" class="banner-page-title-icon" /> */}
                    <span class="banner-page-title-text">{title}</span>
                </div>
            </div>
        </div>
    )}

    <!-- Non-home post banner meta overlay (desktop only) -->
    <BannerPostMetaOverlay showBannerPostMeta={state.showBannerPostMeta} bannerPostInfoMode={state.bannerPostInfoMode} bannerDescriptionWidth={state.bannerDescriptionWidth} bannerPostMeta={bannerPostMeta} />

    </div>

    <!-- Fullscreen 模式下显示向下滚动指示器（仅首页；放在 overlay 容器外，避免被标题视差 transform 带离） -->
    {isHomePage && (state.isFullscreenMode || state.isWallpaperSwitchable) && <ScrollDownIndicator />}

    <!-- Water waves effect - 如果允许切换或任一设备启用则渲染 -->
    {state.shouldRenderWaves ? (
    <div class={`waves absolute -bottom-px h-[10vh] max-h-37.5 min-h-12.5 w-full md:h-[15vh]
        ${!state.wavesEnabledOnMobile ? 'hidden' : ''} ${!state.wavesEnabledOnDesktop ? 'md:hidden' : ''} ${state.wavesEnabledOnDesktop ? 'md:block' : ''}`}
        id="header-waves"
        style="transform: translateZ(0);">
        <!-- 静态占位波浪:随 HTML 首帧渲染,先于壁纸出现避免闪烁;由 WavesEffect.astro 动画 canvas 无缝接管后隐藏 -->
        <svg
            class="waves-svg"
            xmlns="http://www.w3.org/2000/svg"
            xmlns:xlink="http://www.w3.org/1999/xlink"
            viewBox="0 24 150 28"
            preserveAspectRatio="none"
            shape-rendering="geometricPrecision"
            aria-hidden="true"
        >
            <defs>
                <path
                    id="gentle-wave"
                    d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v48h-352z"
                ></path>
            </defs>
            <g>
                <!-- x 偏移 = 四层均匀铺开的起始相位(0/0.25/0.5/0.75)在 t=0 的偏移,首帧即交错,与动画首帧逐像素一致 -->
                <use
                    xlink:href="#gentle-wave"
                    x="-42.000"
                    y="0"
                    class="opacity-25 fill-(--page-bg)"
                ></use>
                <use
                    xlink:href="#gentle-wave"
                    x="2.641"
                    y="3"
                    class="opacity-50 fill-(--page-bg)"
                ></use>
                <use
                    xlink:href="#gentle-wave"
                    x="48.944"
                    y="5"
                    class="opacity-65 fill-(--page-bg)"
                ></use>
                <use
                    xlink:href="#gentle-wave"
                    x="92.468"
                    y="7"
                    class="opacity-75 fill-(--page-bg)"
                ></use>
            </g>
        </svg>
    </div>
    ) : null}

    <!-- Gradient transition - 当水波纹关闭时显示，提供壁纸底部到背景色的平滑过渡 -->
    {state.shouldRenderGradient ? (
    <div class={`wallpaper-gradient absolute bottom-0 left-0 w-full pointer-events-none
        ${!state.gradientEnabledOnMobile ? 'hidden' : ''} ${!state.gradientEnabledOnDesktop ? 'md:hidden' : ''} ${state.gradientEnabledOnDesktop ? 'md:block' : ''}`}
        id="wallpaper-gradient"
        style={`height: ${state.gradientHeight}; background: linear-gradient(to bottom, transparent, var(--page-bg));`}>
    </div>
    ) : null}
</div>
)}

{/* 当壁纸未渲染时，添加空的 Swup 占位容器，避免 Swup 找不到容器而回退为整页加载 */}
{!(state.isWallpaperSwitchable || state.isBannerMode || state.isFullscreenMode || state.isOverlayMode) && (
<>
    <div id="banner-overlay-container" class="hidden"></div>
    <div id="banner-dim-container" class="hidden"></div>
</>
)}

<style is:global>
.hero-3d-layer {
    position: absolute;
    inset: 0;
    z-index: 6;
    overflow: hidden;
    pointer-events: none;
}
.hero-3d-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: auto;
    cursor: grab;
}
.hero-3d-canvas:active { cursor: grabbing; }
.hero-3d-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
}
.hero-char-info {
    position: absolute;
    top: 14%;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: #fff;
    pointer-events: none;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.65);
}
.hero-char-name { display: block; font-size: 1.45rem; font-weight: 700; letter-spacing: 0.08em; }
.hero-char-title { display: block; font-size: 0.82rem; opacity: 0.72; margin-top: 2px; }

/* 滚过首屏后隐藏交互 HUD（避免悬浮在正文之上） */
.hero-3d-layer.hero-hud-hidden .hero-skill-bar,
.hero-3d-layer.hero-hud-hidden .hero-char-switch,
.hero-3d-layer.hero-hud-hidden .hero-cards,
.hero-3d-layer.hero-hud-hidden .hero-char-info { opacity: 0; pointer-events: none; }

.hero-skill-bar {
    position: absolute;
    bottom: 7%;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 14px;
    pointer-events: auto;
    transition: opacity 0.3s ease;
}
.hero-skill-btn {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    cursor: pointer;
    color: var(--skill-color, #9ec5ff);
    background: rgba(16, 18, 26, 0.4);
    border: 1px solid color-mix(in srgb, var(--skill-color, #9ec5ff) 45%, transparent);
    backdrop-filter: blur(10px);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    font-family: inherit;
}
.hero-skill-btn:hover { transform: translateY(-3px); }
.hero-skill-btn.active {
    box-shadow: 0 0 22px var(--skill-color, #9ec5ff);
    border-color: var(--skill-color, #9ec5ff);
    background: color-mix(in srgb, var(--skill-color, #9ec5ff) 18%, rgba(16, 18, 26, 0.4));
}
.hero-skill-label { font-size: 1.5rem; font-weight: 700; text-shadow: 0 0 12px var(--skill-color, #9ec5ff); }

.hero-char-switch {
    position: absolute;
    top: 14%;
    right: 6%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    pointer-events: auto;
    transition: opacity 0.3s ease;
}
.hero-char-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: 12px;
    cursor: pointer;
    color: #fff;
    font-size: 0.85rem;
    background: rgba(16, 18, 26, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);
    transition: transform 0.18s ease, border-color 0.18s ease;
    font-family: inherit;
}
.hero-char-btn:hover { transform: translateX(-3px); }
.hero-char-btn.active { border-color: var(--c, #9ec5ff); box-shadow: 0 0 16px color-mix(in srgb, var(--c, #9ec5ff) 60%, transparent); }
.hero-char-btn-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--c, #9ec5ff);
    box-shadow: 0 0 10px var(--c, #9ec5ff);
}
.hero-char-btn-name { white-space: nowrap; }

.hero-cards {
    position: absolute;
    bottom: 7%;
    right: 6%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    pointer-events: auto;
    transition: opacity 0.3s ease;
}
.hero-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 14px;
    background: rgba(16, 18, 26, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #fff;
    text-decoration: none;
    cursor: pointer;
    backdrop-filter: blur(10px);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    font-family: inherit;
}
.hero-card:hover { transform: translateY(-3px); box-shadow: 0 8px 30px rgba(95, 157, 255, 0.35); }
.hero-card-icon { width: 44px; height: 44px; display: grid; place-items: center; }
.hero-card-text b { display: block; font-size: 0.95rem; font-weight: 700; }
.hero-card-text i { font-style: normal; opacity: 0.7; font-size: 0.72rem; }

.hero-vinyl {
    width: 34px; height: 34px; border-radius: 50%;
    background: radial-gradient(circle at center, #1a1a1a 0 30%, #3a3a3a 31% 100%);
    position: relative;
    animation: hero-spin 3s linear infinite;
}
.hero-vinyl::after {
    content: ""; position: absolute; inset: 40%; border-radius: 50%;
    background: #5b9dff; box-shadow: 0 0 8px #5b9dff;
}
.hero-cube {
    width: 30px; height: 30px; position: relative;
    transform-style: preserve-3d;
    animation: hero-cube-spin 7s linear infinite;
}
.hero-cube i {
    position: absolute; width: 30px; height: 30px;
    border: 1.5px solid #9ec5ff; background: rgba(95, 157, 255, 0.12);
}
.hero-cube i:nth-child(1) { transform: translateZ(15px); }
.hero-cube i:nth-child(2) { transform: rotateY(180deg) translateZ(15px); }
.hero-cube i:nth-child(3) { transform: rotateY(90deg) translateZ(15px); }
.hero-cube i:nth-child(4) { transform: rotateY(-90deg) translateZ(15px); }
.hero-cube i:nth-child(5) { transform: rotateX(90deg) translateZ(15px); }
.hero-cube i:nth-child(6) { transform: rotateX(-90deg) translateZ(15px); }

.hero-toast {
    position: absolute;
    top: 32%;
    left: 50%;
    transform: translate(-50%, -10px);
    min-width: 200px;
    max-width: 80vw;
    padding: 14px 22px;
    border-radius: 14px;
    background: rgba(10, 12, 20, 0.6);
    border: 1px solid rgba(159, 197, 255, 0.35);
    color: #fff;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    backdrop-filter: blur(12px);
    transition: opacity 0.35s ease, transform 0.35s ease;
}
.hero-toast.show { opacity: 1; transform: translate(-50%, 0); }
.hero-toast-main { font-size: 1.3rem; font-weight: 700; letter-spacing: 0.05em; }
.hero-toast-sub { font-size: 0.85rem; opacity: 0.75; margin-top: 4px; }

@keyframes hero-spin { to { transform: rotate(360deg); } }
@keyframes hero-cube-spin { to { transform: rotateX(360deg) rotateY(360deg); } }

@media (max-width: 820px) {
    .hero-char-switch { top: auto; bottom: 20%; right: 4%; flex-direction: row; }
    .hero-cards { bottom: 4%; right: 4%; }
    .hero-skill-bar { bottom: 4%; }
    .hero-char-info { top: 10%; }
}
@media (prefers-reduced-motion: reduce) {
    .hero-vinyl, .hero-cube { animation: none; }
}
</style>

<script>
    (function () {
        var controller = null;
        function isHome() {
            var p = location.pathname.replace(/\/+$/, "");
            return p === "" || p === "/";
        }
        function showFallback(layer) {
            var c = layer.querySelector("#hero-3d-canvas");
            if (c) c.style.display = "none";
            var f = layer.querySelector("#hero-3d-fallback");
            if (f) f.style.display = "block";
        }
        function mount(layer) {
            if (controller) return;
            import("@/utils/hero-character-scene")
                .then(function (mod) { controller = mod.mountHero3D(layer); })
                .catch(function (e) { console.error("[hero3d] init failed", e); showFallback(layer); });
        }
        function wireUI(layer) {
            layer.querySelectorAll("[data-skill]").forEach(function (b) {
                b.addEventListener("click", function () {
                    var k = b.getAttribute("data-skill");
                    if (controller) controller.castSkill(k);
                    layer.querySelectorAll("[data-skill]").forEach(function (x) { x.classList.remove("active"); });
                    b.classList.add("active");
                });
            });
            layer.querySelectorAll("[data-char]").forEach(function (b) {
                b.addEventListener("click", function () {
                    var i = parseInt(b.getAttribute("data-char"), 10);
                    if (controller) controller.switchCharacter(i);
                });
            });
            var music = layer.querySelector('[data-action="music"]');
            if (music) music.addEventListener("click", function (e) {
                e.preventDefault();
                if (window.__fireflyMusic && window.__fireflyMusic.togglePlay) window.__fireflyMusic.togglePlay();
            });
        }
        function ensureHero() {
            var layer = document.getElementById("hero-3d-layer");
            if (!layer) return;
            var imgC = document.getElementById("banner-images-container");
            if (isHome()) {
                layer.style.display = "block";
                if (imgC) imgC.style.display = "none";
                mount(layer);
            } else {
                layer.style.display = "none";
                if (imgC) imgC.style.display = "";
                if (controller) { controller.destroy(); controller = null; }
            }
        }
        var layer0 = document.getElementById("hero-3d-layer");
        if (layer0) wireUI(layer0);
        document.addEventListener("astro:page-load", ensureHero);
        if (document.readyState === "loading") window.addEventListener("DOMContentLoaded", ensureHero);
        else ensureHero();
        window.addEventListener("pagehide", function () {
            if (controller) { controller.destroy(); controller = null; }
        });
        function onScroll() {
            var l = document.getElementById("hero-3d-layer");
            if (!l) return;
            var hide = window.scrollY > window.innerHeight * 0.55;
            l.classList.toggle("hero-hud-hidden", hide);
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
    })();
</script>
